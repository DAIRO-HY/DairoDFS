pipeline {
    agent any

    environment {
        REPO = "DAIRO-HY/DairoDFS"
        BRANCH = "release"
    }
    stages {
        stage("拉取代码") {
            steps {
                script{
                    if(!fileExists("DairoDFS")){

                        //克隆地址里有票据,不要输出到日志
                        sh 'git clone --branch "$BRANCH" "https://${GITHUB_TOKEN}@github.com/${REPO}.git"'
                    }
                }
                dir("DairoDFS"){

                    //撤销所有修改
                    sh "git reset --hard HEAD"

                    //删除所有未被跟踪的文件和目录
                    sh "git clean -fd"
                    sh "git pull"
                }
            }
        }
        stage("构建镜像") {
            steps {
                dir("DairoDFS/document/docker-build"){

                    //--no-cache：忽略缓存，解决一些莫名其妙的问题
                    //--network=host：强制使用主机网络。当在容器中构建镜像时（如：jenkins容器中构建镜像），否则可能会导致网络连接失败而无法通过Dockerfile构建镜像
                    sh "docker build --no-cache --network=host -t dairo-dfs-build ."
                    sh "yes|docker image prune"
                }
            }
        }
        stage("编译") {
            steps {

                //用单引号,票据和密码由shell从环境变量传给docker,不会出现在Jenkins日志里
                //dairo-dfs-src:源码和编译缓存(命名卷,会一直保留,下次只编译有变化的部分)
                //dairo-dfs-cargo-registry:cargo依赖缓存(命名卷,build-linux.sh会传给rust编译容器)
                sh 'docker run -e GITHUB_TOKEN -e DOCKER_USER -e DOCKER_PASSWORD -e BRANCH -v /var/run/docker.sock:/var/run/docker.sock -v dairo-dfs-src:/home/DairoDFS --rm dairo-dfs-build'
            }
        }
    }
}
